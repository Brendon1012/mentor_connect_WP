# Optional. Copy to client/.env only if you need to change these.

# Where the Vite dev server forwards /api requests (the Express backend).
VITE_PROXY_TARGET=http://localhost:5000

# Base URL the browser uses for API calls. Keep "/api" in development (uses the proxy).
# For a separate deployed backend, set the full URL, e.g. https://api.example.com/api
VITE_API_URL=/api
