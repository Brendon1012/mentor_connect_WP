# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express API listens on
PORT=5000

# development | production  (production turns on secure cookies)
NODE_ENV=development

# MongoDB connection string. Local example below; for Atlas use the
# mongodb+srv://... string from "Connect > Drivers" in the Atlas UI.
MONGO_URI=mongodb://127.0.0.1:27017/mentorconnect

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# How long a login lasts
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173

# Optional. Failed login/register attempts allowed per IP per 15 minutes (default 10).
# Only raise this temporarily for automated testing.
# AUTH_RATE_LIMIT_MAX=10
